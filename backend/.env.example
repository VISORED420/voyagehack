# Application
APP_NAME=TBO GroupBook API
APP_VERSION=1.0.0
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/groupbooking

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# TBO API Credentials
TBO_API_URL=http://api.tbotechnology.in/HotelAPI_V7/HotelService.svc
TBO_USERNAME=your_tbo_username
TBO_PASSWORD=your_tbo_password

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
